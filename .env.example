# Copy to .env.local. Never commit real keys. Server-only: no NEXT_PUBLIC_ prefix on secrets (ADR-57).

# Gemini API key for /api/recognize (server-only; create it in Google AI Studio)
GEMINI_API_KEY=

# Upstash Redis for rate-limit counters (ADR-13)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry (ADR-20)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# PostHog, opt-in analytics only (ADR-20)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Gemini model for /api/recognize (defaults to gemini-3.8-flash)
RECOGNITION_MODEL=

# Release tag for Sentry (CI sets GITHUB_SHA or VERCEL_GIT_COMMIT_SHA automatically)
COMMIT_SHA=
