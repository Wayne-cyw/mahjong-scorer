# Copy to .env.local. Never commit real keys. Server-only: no NEXT_PUBLIC_ prefix on secrets (ADR-57).

# Claude API key for /api/recognize
ANTHROPIC_API_KEY=

# Upstash Redis for rate-limit counters (ADR-13)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry (ADR-20)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# PostHog, opt-in analytics only (ADR-20)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Claude model for /api/recognize (defaults to claude-haiku-4-5-20251001)
RECOGNITION_MODEL=
